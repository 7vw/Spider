{
  "name": "spider-tv-os",
  "version": "0.1.0",
  "private": true,
  "description": "SPIDER TV OS — a TV-first launcher and system shell for a standalone HDMI device.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "agent": "node agent/server.js",
    "build": "vite build --config ui/vite.config.ts",
    "start": "node agent/server.js",
    "tv": "npm run build && node scripts/launch.mjs",
    "tv:window": "npm run build && node scripts/launch.mjs --window",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run --config ui/vite.config.ts && node --test agent/test/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
